{
  "Urls": "http://0.0.0.0:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Translation": {
    "Provider": "Local",
    "MaxTextLength": 5000,
    "CacheTtlMinutes": 60,
    "MaxCacheEntries": 10000,
    "RequestTimeoutSeconds": 10,
    "RetryCount": 2
  },
  "AzureTranslator": {
    "Endpoint": "https://api.cognitive.microsofttranslator.com",
    "Key": "",
    "Region": ""
  },
  "RateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 10
  }
}
